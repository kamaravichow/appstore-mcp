# Required: key ID and one private-key source.
ASC_KEY_ID=ABC123DEFG
ASC_PRIVATE_KEY_PATH=/run/secrets/AuthKey_ABC123DEFG.p8
# ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Team keys require the issuer ID. Omit it for an individual key, or set
# ASC_KEY_TYPE explicitly to "team" or "individual".
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_TYPE=auto

# Writes are disabled unless this is explicitly true.
ASC_ENABLE_MUTATIONS=false

# File operations are constrained to these directories.
ASC_UPLOAD_ROOT=.
ASC_DOWNLOAD_ROOT=./downloads

# Optional tuning.
ASC_TOKEN_TTL_SECONDS=600
ASC_REQUEST_TIMEOUT_MS=30000
ASC_MAX_RETRIES=3
ASC_MAX_PAGES=10
ASC_MAX_JSON_RESPONSE_BYTES=10485760
ASC_MAX_DOWNLOAD_BYTES=2147483648
ASC_UPLOAD_CONCURRENCY=4
ASC_UPLOAD_HOST_SUFFIXES=.apple.com
ASC_ALLOW_UNDOCUMENTED_ENDPOINTS=false

# Optional private HTTP transport. Stdio does not use these.
ASC_HTTP_HOST=127.0.0.1
ASC_HTTP_PORT=3000
MCP_BEARER_TOKEN=replace-with-a-long-random-secret
